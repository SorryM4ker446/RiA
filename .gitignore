# dependencies
node_modules/

# next.js
.next/
out/
dist/
electron-dist/
out/
.desktop-runtime/
.desktop-data/
# Scratch database built by `npm run db:check`. The script deletes it when it
# finishes, including when it exits non-zero; this covers the runs where it
# cannot — the process killed, the machine losing power — so a stray database
# never shows up in `git status` waiting to be committed.
.drift-check/
public/generated-videos/

# next generated types
next-env.d.ts
.next/types/
.next/dev/types/

# build / cache
coverage/
test-results/
playwright-report/
blob-report/
.turbo/
*.tsbuildinfo
.eslintcache

# local sqlite: the real database lives in .desktop-data/, but a misconfigured
# DATA_DIR can drop one in the repo root and it must never be committed
*.db
*.sqlite
*.sqlite3

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env (keep template)
.env
.env.*
!.env.example

# local access credential and its diagnostics: never commit these
.local-access-token
access-diagnostic.log

# editor / os
.vscode/
.idea/
.DS_Store
Thumbs.db
