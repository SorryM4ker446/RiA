# Local development stores SQLite data under .desktop-data/dev by default.
# Override with another path relative to the repository root when needed.
LOCAL_DATABASE_FILE=".desktop-data/dev/app.db"
OPENROUTER_API_KEY=""
TAVILY_API_KEY=""
# Optional: embedding model used for semantic memory/knowledge retrieval.
# EMBEDDING_MODEL_ID="openai/text-embedding-3-small"
# Optional: disable authentication (single shared demo user). Enabled by local scripts and E2E.
# AUTH_DISABLED="1"
# Optional: override Tavily endpoint for local E2E/mocks
# TAVILY_SEARCH_URL="http://127.0.0.1:4010/search"
# Optional OpenRouter headers (recommended by OpenRouter)
# OPENROUTER_HTTP_REFERER="http://localhost:3000"
# OPENROUTER_SITE_NAME="Private AI Assistant"
# Optional: force server-side outbound requests through proxy
# OUTBOUND_PROXY_URL="http://127.0.0.1:7897"
# NO_PROXY="localhost,127.0.0.1,::1"
