<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RiA 安装程序" Width="464" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#111214"/>
        <SolidColorBrush x:Key="Control" Color="#191A1D"/>
        <SolidColorBrush x:Key="Border" Color="#34363A"/>
        <SolidColorBrush x:Key="Ink" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="Muted" Color="#B4B4BD"/>
        <SolidColorBrush x:Key="Primary" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="PrimaryInk" Color="#141416"/>
        <SolidColorBrush x:Key="Error" Color="#FFABAB"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="FocusRing" Margin="3" CornerRadius="5" BorderThickness="1"
                                        BorderBrush="{TemplateBinding Foreground}" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.83"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MainButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryInk}"/>
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryInk}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="CaptionBar" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Background="Transparent">
                <DockPanel LastChildFill="True">
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="36" Height="28" Margin="0,3,4,3"
                            Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="关闭">
                        <Path Width="12" Height="12" Stretch="Fill" Data="M 0 0 L 12 12 M 12 0 L 0 12" Stroke="{DynamicResource Ink}" StrokeThickness="1.4"/>
                    </Button>
                    <TextBlock Text="RiA" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="0,10,0,14">
                <Grid Width="248" Height="96" IsHitTestVisible="False">
                    <Grid Width="248" Height="96" Opacity="0.47">
                        <Grid.OpacityMask>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="White" Offset="0.43"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Grid.OpacityMask>
                        <Path Data="M0 10H248 M0 36H248 M0 62H248 M0 88H248 M46 0V96 M72 0V96 M98 0V96 M124 0V96 M150 0V96 M176 0V96 M202 0V96"
                              Stroke="{DynamicResource Border}" StrokeThickness="1"/>
                    </Grid>
                    <Image x:Name="Mark" Width="112" Height="96" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <TextBlock x:Name="Heading" Text="安装 RiA" HorizontalAlignment="Center"
                           FontSize="24" FontWeight="SemiBold" Margin="0,3,0,15"/>
                <Grid Width="376">
                    <Grid x:Name="InstallPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label x:Name="LocationLabel" Content="安装位置" Padding="0" Margin="0,0,0,6"
                               Foreground="{DynamicResource Ink}"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Control}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Height="36">
                                <TextBox x:Name="Location" AutomationProperties.LabeledBy="{Binding ElementName=LocationLabel}"
                                         Padding="10,0" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}"
                                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="14" VerticalContentAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="1" x:Name="Browse" Content="浏览…" MinWidth="88" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Grid.Row="2" x:Name="LocationNote" Text="安装需要管理员权限"
                                   Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,13"/>
                        <Button Grid.Row="3" x:Name="Install" Content="安装" IsDefault="True" Style="{StaticResource MainButton}"/>
                    </Grid>
                    <StackPanel x:Name="StatusPanel" Visibility="Collapsed">
                        <DockPanel x:Name="ProgressRow" LastChildFill="True">
                            <TextBlock x:Name="Percent" DockPanel.Dock="Right" FontFamily="Consolas" Margin="16,0,0,0"/>
                            <TextBlock x:Name="Phase" Text="正在准备安装" TextWrapping="Wrap"/>
                        </DockPanel>
                        <ProgressBar x:Name="ProgressBar" Margin="0,12,0,0" Height="6" Value="0"
                                     AutomationProperties.Name="安装进度"
                                     Foreground="{DynamicResource Primary}" Background="{DynamicResource Border}" BorderThickness="0"/>
                        <TextBlock x:Name="Details" TextWrapping="Wrap" MaxHeight="68" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Muted}"/>
                        <Grid x:Name="Actions" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" x:Name="Secondary" MinWidth="88" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" x:Name="Primary" MinWidth="88" Style="{StaticResource MainButton}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
