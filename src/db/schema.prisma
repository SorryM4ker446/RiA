generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  chats        Chat[]
  memories     Memory[]
  tasks        Task[]
  sessions     Session[]
  mediaAssets  MediaAsset[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Chat {
  id            String    @id @default(cuid())
  userId        String
  title         String
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([userId, lastMessageAt])
  @@map("chats")
}

model Message {
  id             String       @id @default(cuid())
  chatId         String
  clientMessageId String?
  role           MessageRole
  content        String
  status         MessageStatus @default(success)
  createdAt      DateTime     @default(now())
  chat           Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  media          MessageMedia[]

  @@index([chatId, createdAt])
  @@unique([chatId, clientMessageId])
  @@map("messages")
}

model MediaAsset {
  id           String   @id
  userId       String
  relativePath String   @unique
  mediaType    String
  byteSize     Int
  kind         String
  modelId      String?
  description  String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  deletedAt    DateTime?
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  references   MessageMedia[]

  @@index([userId, createdAt])
  @@map("media_assets")
}

model MessageMedia {
  messageId String
  assetId   String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([messageId, assetId])
  @@index([assetId])
  @@map("message_media")
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  score     Float?
  embedding Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("memories")
}

model Task {
  id        String       @id @default(cuid())
  userId    String
  title     String
  details   String?
  dueDate   DateTime?
  priority  TaskPriority @default(medium)
  status    TaskStatus   @default(todo)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("tasks")
}

enum MessageRole {
  user
  assistant
  system
}

enum MessageStatus {
  pending
  success
  error
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskStatus {
  todo
  in_progress
  done
}
