generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One local workspace owns all data. There is no account, no login session and
// no per-user scoping: the local application credential is what protects
// access, and every table below belongs to the single workspace.

model WorkspacePreference {
  id        String   @id @default("local")
  settings  Json
  updatedAt DateTime @updatedAt

  @@map("account_preferences")
}

model ModelCatalogSnapshot {
  providerId String
  mode       String
  models     Json
  fetchedAt  DateTime @default(now())
  // Why the last refresh failed, kept beside the rows it failed to replace.
  lastFailure   String?
  lastFailureAt DateTime?

  @@id([providerId, mode])
  @@index([fetchedAt])
  @@map("model_catalog_snapshots")
}

model ModelRequest {
  id           String   @id @default(cuid())
  requestId    String
  source       String   @default("unattributed")
  estimatedUsd Float?
  mode         String
  modelId      String
  modelProvider String  @default("openrouter")
  status       String
  durationMs   Int
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  costSource   String
  errorCode    String?
  fallback     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt, id])
  @@map("model_requests")
}

model ModelCallDay {
  day           String @id
  calls         Int @default(0)
  estimatedUsd  Float @default(0)
  @@map("model_call_days")
}

model Chat {
  id              String       @id @default(cuid())
  title           String
  pinned          Boolean      @default(false)
  archived        Boolean      @default(false)
  // When set, this conversation neither reads long-term memory nor writes any.
  // It is a switch on memory only: the messages, the draft, uploaded media and
  // recorded usage are still kept, and the interface says so rather than
  // implying the turn left nothing behind.
  ephemeral       Boolean      @default(false)
  // Which document topics this conversation is allowed to draw on. Empty means
  // every topic, which is the default; naming topics narrows the retrieval to
  // what the user put in scope for this conversation.
  documentScope   String       @default("")
  // A model-written summary of the turns before `summaryUpToMessageId`. Kept
  // alongside the messages it came from, so the original text is never replaced
  // by it and can still be read.
  summary         String?
  summaryUpToMessageId String?
  summaryModelId  String?
  historyRevision Int          @default(0)
  summaryRevision Int?

  lastMessageAt   DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  messages        Message[]
  tags            ChatTag[]
  generatedMedia  MediaAsset[]
  agentRuns       AgentRun[]
  scheduledRuns   ScheduledRun[]
  workspaceReview WorkspaceReview?

  @@index([lastMessageAt, id])
  @@index([archived, pinned, lastMessageAt, id])
  @@index([pinned, lastMessageAt, id])
  @@index([createdAt])
  @@map("chats")
}

model ChatTag {
  chatId String
  label  String
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, label])
  @@index([label, chatId])
  @@map("chat_tags")
}

/*
 * One assistant turn that used tools, recorded so it can be inspected, bounded
 * and stopped. A run is what the budget in plan 5.6 is spent against and what
 * "stop the remaining steps" applies to.
 */
model AgentRun {
  id           String   @id @default(cuid())
  chatId       String?
  chat         Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // What the turn was for, in the user's own words where possible.
  goal         String
  status       String   @default("running")
  // Bounded by default. A run that could loop forever is a cost incident, not
  // a feature; each of these is enforced rather than hoped for.
  maxSteps     Int      @default(8)
  maxFailures  Int      @default(2)
  deadlineMs   Int      @default(120000)
  maxCostUsd   Float?
  spentCostUsd Float    @default(0)
  stopReason   String?
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  updatedAt    DateTime @updatedAt
  steps        AgentStep[]

  @@index([chatId, startedAt])
  @@index([status, startedAt])
  @@map("agent_runs")
}

model AgentStep {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  position  Int
  kind      String
  toolName  String?
  state     String   @default("running")
  // A short, already-redacted description: enough to recognise the step in a
  // list without copying a whole result into a second store.
  input     Json?
  output    Json?
  errorCode String?
  startedAt DateTime @default(now())
  finishedAt DateTime?

  @@unique([runId, position])
  @@map("agent_steps")
}

model Message {
  id              String        @id @default(cuid())
  chatId          String
  clientMessageId String?
  role            MessageRole
  content         String
  status          MessageStatus @default(success)
  createdAt       DateTime      @default(now())
  chat            Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  media           MessageMedia[]

  @@index([chatId, createdAt, id])
  @@unique([chatId, clientMessageId])
  @@map("messages")
}

model MediaAsset {
  id                String   @id
  relativePath      String   @unique
  mediaType         String
  byteSize          Int
  kind              String
  modelId           String?
  // Null on assets generated before model references were provider-qualified.
  // Those were all reached through OpenRouter, which is how they are read back.
  modelProvider     String?
  description       String?
  generation        Json?
  sourceChatId      String?
  sourceChat        Chat?    @relation(fields: [sourceChatId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime @default(now())
  deletedAt         DateTime?
  references        MessageMedia[]
  inputs            MediaGenerationInput[] @relation("GenerationOutput")
  usedByGenerations MediaGenerationInput[] @relation("GenerationInput")

  @@index([createdAt, id])
  @@index([sourceChatId])
  @@index([kind])
  @@map("media_assets")
}

model MessageMedia {
  messageId String
  assetId   String
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([messageId, assetId])
  @@index([assetId])
  @@map("message_media")
}

model MediaGenerationInput {
  assetId      String
  inputAssetId String
  asset        MediaAsset @relation("GenerationOutput", fields: [assetId], references: [id], onDelete: Cascade)
  input        MediaAsset @relation("GenerationInput", fields: [inputAssetId], references: [id], onDelete: Cascade)

  @@id([assetId, inputAssetId])
  @@index([inputAssetId])
  @@map("media_generation_inputs")
}

model Memory {
  id        String   @id @default(cuid())
  key       String
  value     String
  score     Float?
  // Where the entry came from. Anything the assistant inferred is marked as
  // such rather than being indistinguishable from something the user wrote.
  source    String   @default("manual")
  // Inferred entries wait for the user to accept them. A confirmed memory can
  // still be edited or deleted, but nothing enters the model's context on the
  // strength of an inference the user never saw.
  confirmed Boolean  @default(true)
  // When this entry was last handed to a model, so the page can say whether a
  // memory is doing anything.
  lastUsedAt DateTime?
  embedding Json?
  embeddingModelId String?
  // A vector is only comparable with the one that produced it, so the provider
  // is stored next to the model id. Null means "written before the provider was
  // recorded", and such vectors are excluded from semantic matching rather than
  // being compared across providers.
  embeddingModelProvider String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key])
  @@index([updatedAt, id])
  @@index([confirmed, updatedAt])
  @@index([embeddingModelProvider, embeddingModelId])
  @@map("memories")
}

model Task {
  id              String       @id @default(cuid())
  title           String
  details         String?
  dueDate         DateTime?
  timeZone        String       @default("UTC")
  reminderEnabled Boolean      @default(false)
  remindedAt      DateTime?
  repeatRule      String       @default("none")
  repeatAnchor    DateTime?
  repeatGenerated Boolean      @default(false)
  priority        TaskPriority @default(medium)
  status          TaskStatus   @default(todo)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([reminderEnabled, remindedAt, dueDate])
  @@index([dueDate])
  @@map("tasks")
}

model KnowledgeDocument {
  id             String   @id @default(cuid())
  filename       String
  // A topic or project this document belongs to. Content organisation for one
  // person, not access control: every document is still readable in the app.
  collection     String?
  format         String
  byteSize       Int
  contentHash    String
  pages          Json
  characterCount Int
  indexVersion   Int
  indexedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  chunks         DocumentChunk[]

  @@unique([filename])
  @@index([updatedAt, id])
  @@index([collection])
  @@map("knowledge_documents")
}

model DocumentChunk {
  id         String @id @default(cuid())
  documentId String
  chunkKey   String
  ordinal    Int
  pageNumber Int?
  text       String
  heading    String?
  tokenCount Int @default(0)
  embedding  Json?
  embeddingModelId String?
  embeddingModelProvider String?
  embeddingContextHash String?
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  terms      DocumentTerm[]

  @@unique([documentId, chunkKey])
  @@index([documentId, ordinal])
  @@index([embeddingModelProvider, embeddingModelId, id])
  @@map("document_chunks")
}

model DocumentTerm {
  chunkId String
  term    String
  frequency Int @default(1)
  chunk   DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([chunkId, term])
  @@index([term, chunkId])
  @@map("document_terms")
}

// A directory the user explicitly opened to the assistant. This is a permission
// on one machine, not workspace content: a Windows path means nothing on
// another machine, and carrying it in a backup would hand a restored archive a
// permission the person restoring it never granted. Grants are therefore
// created on the machine that holds the files and deliberately stay out of
// workspace backup/restore.
model DirectoryGrant {
  id    String @id @default(cuid())
  // What the user recognised when granting, kept so a list of absolute paths
  // stays readable.
  label String
  // The path the user chose, verbatim.
  path  String
  // The resolved real path. Containment is always decided against this rather
  // than `path`, and deliberately against the string as it was when the user
  // granted it: re-resolving the root on every use would move the boundary
  // along with a junction swapped in afterwards, instead of refusing it. What
  // is re-resolved each time is the target inside the grant, and that is what
  // catches such a swap.
  realPath  String @unique
  createdAt DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@index([revokedAt])
  @@map("directory_grants")
}

// A time the user asked something to happen without being present. One local
// process runs these, so a job that is due is claimed rather than merely seen:
// two of them firing at once would create two backups or two reminders.
model ScheduledJob {
  id       String @id @default(cuid())
  // Kept as a string so a kind this version does not know is skipped rather
  // than guessed at, and so a new kind needs no migration to be readable.
  kind    String
  // Disabled by default and stays that way. A schedule that starts on its own
  // is a background process nobody asked for.
  enabled Boolean @default(false)
  useModel Boolean @default(false)
  // The local wall-clock time and the zone it is meant in, kept the same way a
  // reminder is, so a job set for 08:30 stays at 08:30 across a daylight saving
  // change that a stored UTC instant would not survive.
  localTime String
  timeZone  String
  // "daily" or "weekly". Weekly also needs a day; a job that is not weekly
  // ignores it.
  interval  String  @default("daily")
  dayOfWeek Int?
  // When this job is next owed, recomputed after every run rather than advanced
  // blindly, so a machine that was asleep catches up once instead of replaying
  // every interval it slept through.
  nextRunAt  DateTime
  lastRunAt  DateTime?
  // "running" while a run is in flight. A job left running by a process that
  // went away is released on the next start rather than waiting forever.
  lastStatus String?
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  runs       ScheduledRun[]

  @@index([enabled, nextRunAt])
  @@map("scheduled_jobs")
}

model WorkspaceActivityState {
  id String @id @default("local")
  recordingStartedAt DateTime @default(now())
  completeSince DateTime @default(now())
  @@map("workspace_activity_state")
}

model WorkspaceEvent {
  id String @id @default(cuid())
  kind String
  entityId String
  label String
  occurredAt DateTime @default(now())
  @@index([occurredAt, id])
  @@map("workspace_events")
}

model WorkspaceReview {
  id String @id @default(cuid())
  period String
  timeZone String
  startAt DateTime
  endAt DateTime
  facts Json
  chatId String? @unique
  chat Chat? @relation(fields: [chatId], references: [id], onDelete: SetNull)
  modelStatus String @default("disabled")
  modelError String?
  modelText String?
  createdAt DateTime @default(now())
  @@unique([period, timeZone, startAt])
  @@index([createdAt, id])
  @@map("workspace_reviews")
}

// Local execution evidence survives schedule deletion and notice dismissal.
// It is operational history, not portable workspace content.
model ScheduledRun {
  id         String @id @default(cuid())
  jobId      String?
  job        ScheduledJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  kind       String
  trigger    String @default("scheduled")
  retryOf    String? @unique
  requestId  String
  status     String @default("running")
  errorCode  String?
  chatId     String?
  chat       Chat? @relation(fields: [chatId], references: [id], onDelete: SetNull)
  backupId   String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  @@index([startedAt, id])
  @@index([jobId, startedAt])
  @@index([status, startedAt])
  @@map("scheduled_runs")
}

// Something the app wants the user to know about, kept in the app as well as
// possibly on screen. A notification the system refuses to show - disabled, or
// unsupported - must not take the message with it, so the reminder centre reads
// from here rather than from what happened to be displayed.
model AppNotice {
  id    String @id @default(cuid())
  // "backupReminder", "dailyBrief", "taskReminder" and whatever a later version
  // adds. Kept as a string so an unknown kind is shown as itself rather than
  // dropped.
  kind   String
  title  String
  detail String?
  // Where in the app this leads, so clicking it goes somewhere rather than
  // nowhere.
  href String?
  // Repeated notices collapse onto the row they repeat rather than stacking a
  // new one daily.
  fingerprint String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([fingerprint])
  @@index([readAt, createdAt])
  @@map("app_notices")
}

// A copy the application itself wrote to a place the user chose.
//
// Backups the workspace created and backups the user took elsewhere are
// different things: only the first keeps ageing on this machine, and only the
// second is off it. The reminder reads the created ones; this records the
// exported ones so the page can tell the user which is which.
model BackupExport {
  id       String @id @default(cuid())
  backupId String
  // Where the copy was written, on this machine. Shown to the user; never
  // resolved by the application afterwards.
  path       String
  byteSize   Int
  exportedAt DateTime @default(now())

  @@index([exportedAt])
  @@map("backup_exports")
}

enum MessageRole {
  user
  assistant
  system
}

enum MessageStatus {
  pending
  success
  error
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskStatus {
  todo
  in_progress
  done
}
