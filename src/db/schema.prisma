generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One local workspace owns all data. There is no account, no login session and
// no per-user scoping: the local application credential is what protects
// access, and every table below belongs to the single workspace.

model WorkspacePreference {
  id        String   @id @default("local")
  settings  Json
  updatedAt DateTime @updatedAt

  @@map("account_preferences")
}

model ModelRequest {
  id           String   @id @default(cuid())
  requestId    String
  mode         String
  modelId      String
  status       String
  durationMs   Int
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  costSource   String
  errorCode    String?
  fallback     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt, id])
  @@map("model_requests")
}

model Chat {
  id              String       @id @default(cuid())
  title           String
  pinned          Boolean      @default(false)
  archived        Boolean      @default(false)
  lastMessageAt   DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  messages        Message[]
  tags            ChatTag[]
  generatedMedia  MediaAsset[]

  @@index([lastMessageAt, id])
  @@index([archived, pinned, lastMessageAt, id])
  @@index([pinned, lastMessageAt, id])
  @@index([createdAt])
  @@map("chats")
}

model ChatTag {
  chatId String
  label  String
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, label])
  @@index([label, chatId])
  @@map("chat_tags")
}

model Message {
  id              String        @id @default(cuid())
  chatId          String
  clientMessageId String?
  role            MessageRole
  content         String
  status          MessageStatus @default(success)
  createdAt       DateTime      @default(now())
  chat            Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  media           MessageMedia[]

  @@index([chatId, createdAt, id])
  @@unique([chatId, clientMessageId])
  @@map("messages")
}

model MediaAsset {
  id                String   @id
  relativePath      String   @unique
  mediaType         String
  byteSize          Int
  kind              String
  modelId           String?
  description       String?
  generation        Json?
  sourceChatId      String?
  sourceChat        Chat?    @relation(fields: [sourceChatId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime @default(now())
  deletedAt         DateTime?
  references        MessageMedia[]
  inputs            MediaGenerationInput[] @relation("GenerationOutput")
  usedByGenerations MediaGenerationInput[] @relation("GenerationInput")

  @@index([createdAt])
  @@index([createdAt, id])
  @@index([sourceChatId])
  @@index([kind])
  @@map("media_assets")
}

model MessageMedia {
  messageId String
  assetId   String
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([messageId, assetId])
  @@index([assetId])
  @@map("message_media")
}

model MediaGenerationInput {
  assetId      String
  inputAssetId String
  asset        MediaAsset @relation("GenerationOutput", fields: [assetId], references: [id], onDelete: Cascade)
  input        MediaAsset @relation("GenerationInput", fields: [inputAssetId], references: [id], onDelete: Cascade)

  @@id([assetId, inputAssetId])
  @@index([inputAssetId])
  @@map("media_generation_inputs")
}

model Memory {
  id        String   @id @default(cuid())
  key       String
  value     String
  score     Float?
  embedding Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key])
  @@index([updatedAt, id])
  @@map("memories")
}

model Task {
  id              String       @id @default(cuid())
  title           String
  details         String?
  dueDate         DateTime?
  timeZone        String       @default("UTC")
  reminderEnabled Boolean      @default(false)
  remindedAt      DateTime?
  repeatRule      String       @default("none")
  repeatAnchor    DateTime?
  repeatGenerated Boolean      @default(false)
  priority        TaskPriority @default(medium)
  status          TaskStatus   @default(todo)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([reminderEnabled, remindedAt, dueDate])
  @@index([dueDate])
  @@map("tasks")
}

model KnowledgeDocument {
  id             String   @id @default(cuid())
  filename       String
  format         String
  byteSize       Int
  contentHash    String
  pages          Json
  characterCount Int
  indexVersion   Int
  indexedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  chunks         DocumentChunk[]

  @@unique([filename])
  @@index([updatedAt, id])
  @@map("knowledge_documents")
}

model DocumentChunk {
  id         String @id @default(cuid())
  documentId String
  chunkKey   String
  ordinal    Int
  pageNumber Int?
  text       String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  terms      DocumentTerm[]

  @@unique([documentId, chunkKey])
  @@index([documentId, ordinal])
  @@map("document_chunks")
}

model DocumentTerm {
  chunkId String
  term    String
  chunk   DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([chunkId, term])
  @@index([term, chunkId])
  @@map("document_terms")
}

enum MessageRole {
  user
  assistant
  system
}

enum MessageStatus {
  pending
  success
  error
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskStatus {
  todo
  in_progress
  done
}
