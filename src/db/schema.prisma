generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One local workspace owns all data. There is no account, no login session and
// no per-user scoping: the local application credential is what protects
// access, and every table below belongs to the single workspace.

model WorkspacePreference {
  id        String   @id @default("local")
  settings  Json
  updatedAt DateTime @updatedAt

  @@map("account_preferences")
}

model ModelCatalogSnapshot {
  providerId String
  mode       String
  models     Json
  fetchedAt  DateTime @default(now())
  // Why the last refresh failed, kept beside the rows it failed to replace.
  lastFailure   String?
  lastFailureAt DateTime?

  @@id([providerId, mode])
  @@index([fetchedAt])
  @@map("model_catalog_snapshots")
}

model ModelRequest {
  id           String   @id @default(cuid())
  requestId    String
  source       String   @default("unattributed")
  estimatedUsd Float?
  mode         String
  modelId      String
  modelProvider String  @default("openrouter")
  status       String
  durationMs   Int
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  costSource   String
  errorCode    String?
  fallback     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt, id])
  @@map("model_requests")
}

model ModelCallDay {
  day           String @id
  calls         Int @default(0)
  estimatedUsd  Float @default(0)
  @@map("model_call_days")
}

/// Recent ratios of provider-reported to locally estimated input tokens.
/// A derived planning cache: losing it only resets calibration to the estimate.
model ModelContextCalibration {
  modelKey   String   @id
  samples    String   @default("[]")
  updatedAt  DateTime @updatedAt
  @@map("model_context_calibrations")
}

model Chat {
  id              String       @id @default(cuid())
  title           String
  // Who the title is from: "auto" while it is the placeholder the app made from
  // the first message (a short model-written title may replace it), "named" once
  // that happened, was given up on, or the title came from elsewhere (a task),
  // and "manual" once the user named it. Nothing replaces "named" or "manual".
  titleSource     String       @default("named")
  pinned          Boolean      @default(false)
  archived        Boolean      @default(false)
  // When set, this conversation neither reads long-term memory nor writes any.
  // It is a switch on memory only: the messages, the draft, uploaded media and
  // recorded usage are still kept, and the interface says so rather than
  // implying the turn left nothing behind.
  ephemeral       Boolean      @default(false)
  // The one granted folder this conversation works in. Choosing is not
  // granting: only an active grant can be chosen, and withdrawing the grant
  // clears the choice. Like the grant itself it is machine-local and stays
  // out of workspace backups.
  workspaceGrantId String?
  workspaceGrant  DirectoryGrant? @relation(fields: [workspaceGrantId], references: [id], onDelete: SetNull)
  // What the model may do in the workspace without asking: "ask" before file
  // edits and terminal commands, "acceptEdits" to make file edits and ask
  // before commands, "full" to do both. A new conversation starts from the
  // default rule; a task's conversation uses the task's rule instead.
  approvalRule    String       @default("ask")
  assistantConfig Json?
  modelPreferences Json?
  // A model-written summary of the turns before `summaryUpToMessageId`. Kept
  // alongside the messages it came from, so the original text is never replaced
  // by it and can still be read.
  summary         String?
  summaryUpToMessageId String?
  summaryModelId  String?
  // The tool calls the summary stands in for and what to put back after a fold, as JSON.
  summaryState    String?
  // When a turn last asked for memories to be extracted from this conversation.
  memoryExtractedAt DateTime?
  // When long-term memory was last turned back on. Notes are read only from messages after it.
  memoryResumedAt DateTime?
  // An answer arrived that the user has not opened yet: set when a turn ends
  // here (other than one the user stopped), cleared when the conversation is opened.
  unread          Boolean      @default(false)
  historyRevision Int          @default(0)
  summaryRevision Int?

  lastMessageAt   DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  messages        Message[]
  tags            ChatTag[]
  generatedMedia  MediaAsset[]
  agentRuns       AgentRun[]
  subagentRuns    SubagentRun[]
  fileCheckpoints FileCheckpoint[]
  scheduledRuns   ScheduledRun[]
  scheduledJobs   ScheduledJob[]
  workspaceReview WorkspaceReview?

  @@index([lastMessageAt, id])
  @@index([archived, pinned, lastMessageAt, id])
  @@index([pinned, lastMessageAt, id])
  @@index([createdAt])
  @@map("chats")
}

model AssistantTemplate {
  id        String   @id @default(cuid())
  config    Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assistant_templates")
}

model ChatTag {
  chatId String
  label  String
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, label])
  @@index([label, chatId])
  @@map("chat_tags")
}

/*
 * One assistant turn that used tools, recorded so it can be inspected, bounded
 * and stopped. A run is what the budget in plan 5.6 is spent against and what
 * "stop the remaining steps" applies to.
 */
model AgentRun {
  id           String   @id @default(cuid())
  chatId       String?
  chat         Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // What the turn was for, in the user's own words where possible.
  goal         String
  status       String   @default("running")
  // Null limits leave new runs unbounded; historical budgets stay recorded.
  maxSteps     Int?
  maxFailures  Int?
  deadlineMs   Int?
  maxCostUsd   Float?
  spentCostUsd Float    @default(0)
  stopReason   String?
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  updatedAt    DateTime @updatedAt
  steps        AgentStep[]
  fileCheckpoints FileCheckpoint[]

  @@index([chatId, startedAt])
  @@index([status, startedAt])
  @@map("agent_runs")
}

/// A task sub-agent: one piece of work the model handed off with runSubagent.
/// In the foreground the turn waits for its report; in the background the turn
/// goes on and the report reaches the model when it is done. The row is what
/// the conversation's card reads, and what a restart finds: one still marked
/// running then was cut off with the process, and is marked interrupted.
model SubagentRun {
  id          String   @id
  chatId      String
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  /// The run of the turn that started it, where its tool calls are recorded.
  runId       String?
  /// The runSubagent call that started it.
  toolCallId  String
  title       String
  task        String
  background  Boolean  @default(false)
  /// running, done, failed, stopped or interrupted.
  status      String   @default("running")
  report      String?
  /// The actions it did not run because they needed the user's approval, as JSON.
  notRun      Json?
  toolCalls   Int      @default(0)
  error       String?
  /// Whether the model has been given its report, in a turn or by checkSubagents.
  delivered   Boolean  @default(false)
  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  @@index([chatId, startedAt])
  @@index([status])
  @@map("subagent_runs")
}

model AgentStep {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  position  Int
  kind      String
  toolName  String?
  toolCallId String?
  /// For a task sub-agent's own call: the call that started the sub-agent.
  parentToolCallId String?
  state     String   @default("running")
  // A short, already-redacted description: enough to recognise the step in a
  // list without copying a whole result into a second store.
  input     Json?
  output    Json?
  errorCode String?
  startedAt DateTime @default(now())
  finishedAt DateTime?

  @@unique([runId, position])
  @@map("agent_steps")
}

model Message {
  id              String        @id @default(cuid())
  chatId          String
  clientMessageId String?
  role            MessageRole
  content         String
  status          MessageStatus @default(success)
  requestContext  String?
  createdAt       DateTime      @default(now())
  chat            Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  media           MessageMedia[]

  @@index([chatId, createdAt, id])
  @@unique([chatId, clientMessageId])
  @@map("messages")
}

model MediaAsset {
  id                String   @id
  relativePath      String   @unique
  mediaType         String
  byteSize          Int
  /// SHA-256 of the bytes, hex. Null on assets stored before it was kept, until one is compared.
  contentHash       String?
  kind              String
  modelId           String?
  // Null on assets generated before model references were provider-qualified.
  // Those were all reached through OpenRouter, which is how they are read back.
  modelProvider     String?
  description       String?
  generation        Json?
  sourceChatId      String?
  sourceChat        Chat?    @relation(fields: [sourceChatId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime @default(now())
  deletedAt         DateTime?
  references        MessageMedia[]
  inputs            MediaGenerationInput[] @relation("GenerationOutput")
  usedByGenerations MediaGenerationInput[] @relation("GenerationInput")

  @@index([createdAt, id])
  @@index([sourceChatId])
  @@index([kind])
  @@index([mediaType, byteSize])
  @@map("media_assets")
}

model MessageMedia {
  messageId String
  assetId   String
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([messageId, assetId])
  @@index([assetId])
  @@map("message_media")
}

model MediaGenerationInput {
  assetId      String
  inputAssetId String
  asset        MediaAsset @relation("GenerationOutput", fields: [assetId], references: [id], onDelete: Cascade)
  input        MediaAsset @relation("GenerationInput", fields: [inputAssetId], references: [id], onDelete: Cascade)

  @@id([assetId, inputAssetId])
  @@index([inputAssetId])
  @@map("media_generation_inputs")
}

// MEMORY.md: what the model has noted across conversations. There is one, and it is
// kept here so it travels with backups and every write can check what it was based on.
model MemoryDocument {
  id        String   @id @default("local")
  content   String   @default("")
  revision  Int      @default(0)
  // The revision of a person's latest deletion: copies older than this are not sent again.
  deletedRevision Int @default(0)
  // How the notes are sorted for a person to look through, as JSON. Worked out from them,
  // and never sent to a model as memory.
  topics    String   @default("[]")
  updatedAt DateTime @updatedAt

  @@map("memory_documents")
}

model Memory {
  id        String   @id @default(cuid())
  key       String
  value     String
  score     Float?
  // Where the entry came from. Anything the assistant inferred is marked as
  // such rather than being indistinguishable from something the user wrote.
  source    String   @default("manual")
  // Inferred entries wait for the user to accept them. A confirmed memory can
  // still be edited or deleted, but nothing enters the model's context on the
  // strength of an inference the user never saw.
  confirmed Boolean  @default(true)
  // When this entry was last handed to a model, so the page can say whether a
  // memory is doing anything.
  lastUsedAt DateTime?
  embedding Json?
  embeddingModelId String?
  // A vector is only comparable with the one that produced it, so the provider
  // is stored next to the model id. Null means "written before the provider was
  // recorded", and such vectors are excluded from semantic matching rather than
  // being compared across providers.
  embeddingModelProvider String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key])
  @@index([updatedAt, id])
  @@index([confirmed, updatedAt])
  @@index([embeddingModelProvider, embeddingModelId])
  @@map("memories")
}

model KnowledgeDocument {
  id             String   @id @default(cuid())
  filename       String
  // A topic or project this document belongs to. Content organisation for one
  // person, not access control: every document is still readable in the app.
  collection     String?
  format         String
  byteSize       Int
  contentHash    String
  pages          Json
  characterCount Int
  indexVersion   Int
  indexedAt      DateTime @default(now())
  /// Bumped by triggers whenever the chunks or their vectors change; the search index reloads by it.
  vectorRevision Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  chunks         DocumentChunk[]
  ocr            DocumentOcr?
  folderFiles    KnowledgeFolderFile[]

  @@unique([filename])
  @@index([updatedAt, id])
  @@index([collection])
  @@map("knowledge_documents")
}

model DocumentChunk {
  id         String @id @default(cuid())
  documentId String
  chunkKey   String
  ordinal    Int
  pageNumber Int?
  text       String
  heading    String?
  tokenCount Int @default(0)
  /// Vectors written before they were stored as binary; emptied by the migration and kept so older builds still read the table.
  embedding  Json?
  /// The vector as normalised little-endian Float32. Cleared by triggers when the text, section, file name or collection changes.
  vector     Bytes?
  embeddingModelId String?
  embeddingModelProvider String?
  embeddingContextHash String?
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  search     DocumentChunkSearch?

  @@unique([documentId, chunkKey])
  @@index([documentId, ordinal])
  @@index([embeddingModelProvider, embeddingModelId, id])
  @@map("document_chunks")
}

/// Text recognition for a scanned PDF's pages without a text layer. The PDF waits in
/// the cache folder (ocr/<documentId>.pdf) until every page is read and the text is in
/// the document. `sourceHash` is the PDF's SHA-256, so the same file imported again
/// reuses the text instead of reading it twice; `contentHash` is the document version
/// the job belongs to, and a job whose document has moved on is dropped.
model DocumentOcr {
  id          String            @id @default(cuid())
  documentId  String            @unique
  sourceHash  String
  contentHash String
  /// Page numbers still to be read, in order.
  pages       Json
  /// The text read so far, by page number.
  results     Json
  /// pending, running, failed or done.
  status      String            @default("pending")
  error       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("document_ocr")
}

/// A chunk's keyword terms for the full-text index `document_chunk_search_index`
/// (an FTS5 table kept in step by triggers, created in its migration). Each term
/// is its UTF-8 bytes in hexadecimal, repeated by its frequency, so the index's
/// tokenizer never splits a term and BM25 sees the chunk's term frequencies.
model DocumentChunkSearch {
  id      Int           @id @default(autoincrement())
  chunkId String        @unique
  terms   String
  chunk   DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@map("document_chunk_search")
}

// A directory the user explicitly opened to the assistant. This is a permission
// on one machine, not workspace content: a Windows path means nothing on
// another machine, and carrying it in a backup would hand a restored archive a
// permission the person restoring it never granted. Grants are therefore
// created on the machine that holds the files and deliberately stay out of
// workspace backup/restore.
model DirectoryGrant {
  id    String @id @default(cuid())
  // What the user recognised when granting, kept so a list of absolute paths
  // stays readable.
  label String
  // The path the user chose, verbatim.
  path  String
  // The resolved real path. Containment is always decided against this rather
  // than `path`, and deliberately against the string as it was when the user
  // granted it: re-resolving the root on every use would move the boundary
  // along with a junction swapped in afterwards, instead of refusing it. What
  // is re-resolved each time is the target inside the grant, and that is what
  // catches such a swap.
  realPath  String @unique
  createdAt DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?
  updatedAt DateTime  @updatedAt
  chats     Chat[]
  tasks     ScheduledJob[]

  @@index([revokedAt])
  @@map("directory_grants")
}

// A task: something the user asked to happen at a time, without being present.
// One local process runs these, so a task that is due is claimed rather than
// merely seen: two of them firing at once would run the same thing twice.
model ScheduledJob {
  id       String @id @default(cuid())
  // "prompt" is carried out by the model in the task's own conversation. The
  // others are built-in actions that involve no model. Kept as a string so a
  // kind this version does not know is skipped rather than guessed at.
  kind    String
  title   String @default("")
  // What the model is asked to do each time. Built-in actions have none.
  prompt  String?
  // Disabled by default and stays that way. A task that starts on its own
  // is a background process nobody asked for.
  enabled Boolean @default(false)
  // A five-field cron expression read in `timeZone`, so a task set for 08:30
  // stays at 08:30 across a daylight saving change. Without one the task runs
  // once, at `nextRunAt`, and is switched off afterwards; without either it
  // runs only when started by hand.
  cron      String?
  timeZone  String
  // A time that passed while RiA was not running, or too busy to start it:
  // run once when possible (true) or wait for the next time (false).
  catchUp   Boolean @default(true)
  // The template a task was made from. An empty title or a missing prompt
  // means that part was not rewritten: the template's wording, in the
  // interface language, is used each time it is shown or run.
  template  String?
  // The one conversation every run of this task continues. Created with the
  // first run; if it is deleted, the next run starts another.
  chatId    String?
  chat      Chat? @relation(fields: [chatId], references: [id], onDelete: SetNull)
  // The model every turn in the task's conversation uses, whether the task or
  // the user sent it. Both null: the default chat model at the time of the turn.
  modelProvider String?
  modelId       String?
  // The folder every turn in the task's conversation works in. Kept on the task
  // rather than the conversation, so the first run already has it and a new
  // conversation after a deletion keeps it. Withdrawing the grant clears it.
  workspaceGrantId String?
  workspaceGrant   DirectoryGrant? @relation(fields: [workspaceGrantId], references: [id], onDelete: SetNull)
  // What the task's turns may do in its folder without asking, as for a
  // conversation. "ask" stops a run at the first edit or command.
  approvalRule String @default("ask")
  // Whether the task's conversation contributes to and reads long-term memory.
  usesMemory   Boolean @default(false)
  // Which outcomes become system notifications: "all", "important" (anything
  // but a plain success) or "off". The notice in the app is raised either way.
  notify       String @default("all")
  // How hard the model reasons on the task's turns; null follows the app's setting.
  reasoningEffort String?
  // When this task is next owed, recomputed after every run rather than advanced
  // blindly, so a machine that was asleep catches up once instead of replaying
  // every occurrence it slept through.
  // Null for a task that runs only when started by hand.
  nextRunAt  DateTime?
  lastRunAt  DateTime?
  // "running" while a run is in flight. A task left running by a process that
  // went away is released on the next start rather than waiting forever.
  lastStatus String?
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  runs       ScheduledRun[]

  @@index([enabled, nextRunAt])
  @@map("scheduled_jobs")
}

model WorkspaceActivityState {
  id String @id @default("local")
  recordingStartedAt DateTime @default(now())
  completeSince DateTime @default(now())
  @@map("workspace_activity_state")
}

model WorkspaceEvent {
  id String @id @default(cuid())
  kind String
  entityId String
  label String
  occurredAt DateTime @default(now())
  @@index([occurredAt, id])
  @@map("workspace_events")
}

model WorkspaceReview {
  id String @id @default(cuid())
  period String
  timeZone String
  startAt DateTime
  endAt DateTime
  facts Json
  chatId String? @unique
  chat Chat? @relation(fields: [chatId], references: [id], onDelete: SetNull)
  modelStatus String @default("disabled")
  modelError String?
  modelText String?
  createdAt DateTime @default(now())
  @@unique([period, timeZone, startAt])
  @@index([createdAt, id])
  @@map("workspace_reviews")
}

// Local execution evidence survives schedule deletion and notice dismissal.
// It is operational history, not portable workspace content.
model ScheduledRun {
  id         String @id @default(cuid())
  jobId      String?
  job        ScheduledJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  kind       String
  trigger    String @default("scheduled")
  retryOf    String? @unique
  requestId  String
  status     String @default("running")
  errorCode  String?
  chatId     String?
  chat       Chat? @relation(fields: [chatId], references: [id], onDelete: SetNull)
  backupId   String?
  // When a run that started on its own was due, and how many later times of
  // the same task passed before it finished without a run of their own.
  scheduledFor DateTime?
  missedCount  Int @default(0)
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  @@index([startedAt, id])
  @@index([jobId, startedAt])
  @@index([status, startedAt])
  @@map("scheduled_runs")
}

// Something the app wants the user to know about, kept in the app as well as
// possibly on screen. A notification the system refuses to show - disabled, or
// unsupported - must not take the message with it, so the reminder centre reads
// from here rather than from what happened to be displayed.
model AppNotice {
  id    String @id @default(cuid())
  // "backupReminder", "dailyBrief", "taskReminder" and whatever a later version
  // adds. Kept as a string so an unknown kind is shown as itself rather than
  // dropped.
  kind   String
  title  String
  detail String?
  // Where in the app this leads, so clicking it goes somewhere rather than
  // nowhere.
  href String?
  // Repeated notices collapse onto the row they repeat rather than stacking a
  // new one daily.
  fingerprint String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  // When the desktop was handed this notice to show as a system notification.
  // Raising the notice again clears it, so the repeat is announced too.
  notifiedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([fingerprint])
  @@index([readAt, createdAt])
  @@map("app_notices")
}

// A copy the application itself wrote to a place the user chose.
//
// Backups the workspace created and backups the user took elsewhere are
// different things: only the first keeps ageing on this machine, and only the
// second is off it. The reminder reads the created ones; this records the
// exported ones so the page can tell the user which is which.
model BackupExport {
  id       String @id @default(cuid())
  backupId String
  // Where the copy was written, on this machine. Shown to the user; never
  // resolved by the application afterwards.
  path       String
  byteSize   Int
  exportedAt DateTime @default(now())

  @@index([exportedAt])
  @@map("backup_exports")
}

// Extensions are machine-local connections; credentials never enter portable backups.
model Extension {
  id          String   @id
  name        String
  kind        String
  config      Json
  credentials String?
  tools       Json
  enabled     Boolean  @default(false)
  revision    Int      @default(1)
  testedRevision Int?
  testId      String?
  lastTestAt  DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pluginId    String?
  pluginKey   String?
  plugin      PluginPackage? @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, pluginKey])
  @@map("extensions")
}

model PluginPackage {
  id        String @id
  packageId String @unique
  manifest  Json
  digest    String
  enabled   Boolean @default(false)
  revision  Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  connections Extension[]

  @@map("plugin_packages")
}

enum MessageRole {
  user
  assistant
  system
}

enum MessageStatus {
  pending
  success
  error
}

/// The interface language the user chose, so work that runs unattended is worded in it.
// The approval rule a new conversation starts with. One row.
model ApprovalPreference {
  id          String   @id @default("local")
  defaultRule String   @default("ask")
  updatedAt   DateTime @updatedAt
  @@map("approval_preferences")
}

model InterfacePreference {
  id        String   @id @default("local")
  locale    String
  updatedAt DateTime @updatedAt
  @@map("interface_preferences")
}

// What a turn changed in a workspace file, kept so the change can be undone.
// The content before (and after) lives in a content-addressed store beside the
// database (`checkpoints/blobs/<sha256>`); a row only names the hashes. A null
// kind says whether the turn created, modified or deleted the file.
model FileCheckpoint {
  id          String    @id @default(cuid())
  chatId      String
  chat        Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  runId       String?
  run         AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  grantId     String
  // The folder's real path when the change was made; undo refuses once the grant points elsewhere.
  root        String
  path        String
  // "edit" (editProjectFile) or "terminal" (a command's observed changes).
  source      String
  // "created", "modified" or "deleted".
  kind        String
  // Full SHA-256 of the content; null when there was none (created / deleted) or it was not read.
  beforeHash  String?
  afterHash   String?
  beforeBytes Int?
  afterBytes  Int?
  // Set when the content before is the file's blob in the workspace's git repository,
  // restored from there rather than from a copy.
  beforeGitOid String?
  // False when the content before could not be kept (too large, not read in time); reason says which.
  restorable  Boolean   @default(true)
  reason      String?
  createdAt   DateTime  @default(now())
  undoneAt    DateTime?

  @@index([chatId, runId])
  @@index([grantId])
  @@index([createdAt])
  @@map("file_checkpoints")
}

// How much the undo store may hold, in MiB.
model CheckpointPreference {
  id        String   @id @default("local")
  limitMb   Int      @default(2048)
  updatedAt DateTime @updatedAt
  @@map("checkpoint_preferences")
}

/// A folder the knowledge base keeps in step with. Only read: adding one grants the assistant nothing.
model KnowledgeFolder {
  id           String                @id @default(cuid())
  /// The folder's name as shown, and the first part of its documents' names; unique among folders.
  label        String                @unique
  /// The path the user chose, verbatim.
  path         String
  /// The resolved real path when it was added; the boundary of every scan.
  realPath     String                @unique
  /// The topic its documents are filed under.
  collection   String?
  /// pending, synced, missing or failed; whether a sync is running is known only to the running service.
  status       String                @default("pending")
  error        String?
  lastSyncedAt DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  files        KnowledgeFolderFile[]

  @@map("knowledge_folders")
}

/// One supported file in a synced folder, as last seen, and the document it became.
model KnowledgeFolderFile {
  id           String             @id @default(cuid())
  folderId     String
  /// Inside the folder, with forward slashes.
  relativePath String
  documentId   String?
  byteSize     Int
  /// The file's modification time in whole milliseconds.
  modifiedAt   Float
  /// synced, failed or skipped.
  status       String
  error        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  folder       KnowledgeFolder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  document     KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([folderId, relativePath])
  @@index([documentId])
  @@map("knowledge_folder_files")
}
